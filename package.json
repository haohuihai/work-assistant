{
  "name": "work-assistant",
  "displayName": "工作助手 (Work Assistant)",
  "description": "基于 Swagger/OpenAPI 的工作助手，用于管理接口项目、搜索请求、查看接口详情并测试 API。",
  "version": "0.1.3",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "swaggerHelper.openUI",
        "title": "工作助手: 添加项目"
      },
      {
        "command": "swaggerHelper.lookupRoute",
        "title": "工作助手: 查找路由"
      },
      {
        "command": "swaggerHelper.addProject",
        "title": "新增项目"
      },
      {
        "command": "swaggerHelper.searchRequests",
        "title": "搜索URL"
      },
      {
        "command": "swaggerHelper.clearSearch",
        "title": "清空搜索"
      },
      {
        "command": "swaggerHelper.renameProject",
        "title": "修改标题"
      },
      {
        "command": "swaggerHelper.refreshProject",
        "title": "更新"
      },
      {
        "command": "swaggerHelper.openApiDetail",
        "title": "打开接口详情"
      },
      {
        "command": "swaggerHelper.showPipelineList",
        "title": "查看流水线"
      },
      {
        "command": "swaggerHelper.openApiTestPage",
        "title": "工作助手: 打开 API 测试页"
      },
      {
        "command": "swaggerHelper.publish",
        "title": "npm run publish"
      },
      {
        "command": "swaggerHelper.aiCheckAndCommit",
        "title": "AI 校验后提交",
        "category": "Git"
      },
      {
        "command": "swaggerHelper.installCommitGuardHook",
        "title": "安装提交前校验 Hook",
        "category": "Git"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "swaggerHelper",
          "title": "工作助手",
          "icon": "resources/work.svg"
        }
      ]
    },
    "views": {
      "swaggerHelper": [
        {
          "id": "swaggerHelper.workView",
          "name": "工作"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "swaggerHelper.apiTestCustomEditor",
        "displayName": "API 测试自定义编辑器",
        "selector": [
          {
            "filenamePattern": "*.apitest"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "swaggerHelper.addProject",
          "when": "view == swaggerHelper.workView",
          "group": "navigation@1"
        },
        {
          "command": "swaggerHelper.searchRequests",
          "when": "view == swaggerHelper.workView",
          "group": "navigation@2"
        },
        {
          "command": "swaggerHelper.clearSearch",
          "when": "view == swaggerHelper.workView",
          "group": "navigation@3"
        },
        {
          "command": "swaggerHelper.showPipelineList",
          "when": "view == swaggerHelper.workView",
          "group": "navigation@4"
        },
        {
          "command": "swaggerHelper.openApiTestPage",
          "when": "view == swaggerHelper.apiTestPage",
          "group": "navigation@1"
        }
      ],
      "scm/title": [
        {
          "command": "swaggerHelper.aiCheckAndCommit",
          "when": "scmProvider == git",
          "group": "2_main@1"
        }
      ],
      "commandPalette": [
        {
          "command": "swaggerHelper.aiCheckAndCommit"
        },
        {
          "command": "swaggerHelper.installCommitGuardHook"
        }
      ],
      "view/item/context": [
        {
          "command": "swaggerHelper.renameProject",
          "when": "view == swaggerHelper.workView && viewItem == project",
          "group": "inline@1"
        },
        {
          "command": "swaggerHelper.refreshProject",
          "when": "view == swaggerHelper.workView && viewItem == project",
          "group": "inline@2"
        }
      ],
      "editor/context": [
        {
          "command": "swaggerHelper.publish",
          "when": "editorFocus",
          "group": "navigation@99"
        }
      ]
    },
    "configuration": {
      "title": "工作助手",
      "properties": {
        "swaggerHelper.yunxiao.domain": {
          "type": "string",
          "default": "openapi-rdc.aliyuncs.com",
          "description": "云效服务接入点域名或基础 URL，例如 https://example.aliyun.com 或 https://example.aliyun.com/oapi/v1/flow。"
        },
        "swaggerHelper.yunxiao.token": {
          "type": "string",
          "default": "",
          "description": "云效个人访问令牌，用于 x-yunxiao-token 认证。查看流水线需只读权限，操作人工卡点需流水线运行任务读写权限。"
        },
        "swaggerHelper.yunxiao.organizationId": {
          "type": "string",
          "default": "",
          "description": "云效中心版 organizationId（中心站 openapi-rdc.aliyuncs.com 必填）。可在云效「组织管理后台 → 基本信息」查看。"
        },
        "swaggerHelper.yunxiao.page": {
          "type": "number",
          "default": 1,
          "description": "默认流水线列表页码。"
        },
        "swaggerHelper.yunxiao.perPage": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 50,
          "description": "默认流水线列表每页条数。"
        },
        "swaggerHelper.debugHttp": {
          "type": "boolean",
          "default": false,
          "description": "开启后在「工作助手 HTTP」输出面板记录插件发出的 HTTP 请求与响应（token 会自动脱敏）。"
        },
        "swaggerHelper.qwen.apiKey": {
          "type": "string",
          "default": "",
          "description": "阿里云百炼（DashScope）API Key，用于调用通义千问。可在百炼控制台创建并复制。"
        },
        "swaggerHelper.qwen.baseUrl": {
          "type": "string",
          "default": "https://dashscope.aliyuncs.com/compatible-mode/v1",
          "description": "千问 OpenAI 兼容接口 Base URL。国内默认 dashscope.aliyuncs.com；国际可用 dashscope-intl.aliyuncs.com。"
        },
        "swaggerHelper.qwen.model": {
          "type": "string",
          "default": "qwen-plus",
          "description": "千问模型名称，例如 qwen-plus、qwen-turbo、qwen-max。"
        }
      }
    }
  },
  "files": [
    "out",
    "resources",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git"
  },
  "publisher": "coder-hai-11",
  "scripts": {
    "prepackage": "pnpm run compile",
    "package": "vsce package",
    "inittsc": "tsc --init --rootDir src --outDir out --esModuleInterop",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "publish": "pnpm run package && vsce publish"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}
